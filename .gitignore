# Unreal Engine 5 project ignores
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vscode/
.vs/
*.VC.db
*.opendb
*.sln

# Unreal Generated Files
*.generated.h
*.gen.cpp

# Autogenerated files
*.patch
*.diff

# Platform Builds
/Build/*
!/Build/Scripts
!/Build/Scripts/*

# Blender backup files
*.blend1
*.blend2

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Crash reports and logs
*.log
*.dmp
*.crashinfo

# Task logs and scratch
/agents/tasks/*.log
