# Unreal Engine 5 project ignores
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vscode/
.vs/
*.VC.db
*.opendb
*.sln

# Unreal Generated Files
*.generated.h
*.gen.cpp

# Autogenerated files
*.patch
*.diff

# Platform Builds
/Build/*
!/Build/Scripts
!/Build/Scripts/*

# Blender backup files
*.blend1
*.blend2

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Crash reports and logs
*.log
*.dmp
*.crashinfo

# Task logs and scratch
/agents/tasks/*.log

# Local Claude Code settings and editor-generated engine config with a device token
.claude/settings.local.json

# GIS data: reproducible by tools/world scripts; manifests and checksums are committed instead
/data/raw/
/data/derived/
__pycache__/
